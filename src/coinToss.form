<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="coinToss">
  <grid id="27dc6" binding="coinTossMainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="c58df" binding="coinTossCenterPanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="b61f5" class="javax.swing.JLabel" binding="coinTossImage">
            <constraints/>
            <properties>
              <horizontalAlignment value="0"/>
              <horizontalTextPosition value="0"/>
              <text value="Image"/>
              <verticalAlignment value="0"/>
              <verticalTextPosition value="0"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="5c11e" binding="coinTossTopPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints border-constraint="North"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="eab1" class="javax.swing.JButton" binding="coinTossReturnButton">
            <constraints border-constraint="West"/>
            <properties>
              <horizontalAlignment value="0"/>
              <text value="Return"/>
            </properties>
          </component>
          <component id="44493" class="javax.swing.JLabel" binding="coinTossTitleLabel">
            <constraints border-constraint="Center"/>
            <properties>
              <horizontalAlignment value="0"/>
              <text value="Coin Toss"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="c4a02" binding="coinTossBottomPanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
        <constraints border-constraint="South"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="13702" class="javax.swing.JTextField" binding="coinTossBetEntry">
            <constraints/>
            <properties/>
          </component>
          <hspacer id="6f10d">
            <constraints/>
          </hspacer>
          <component id="3098" class="javax.swing.JComboBox" binding="coinTossBetChoice">
            <constraints/>
            <properties/>
          </component>
          <component id="a26a4" class="javax.swing.JButton" binding="coinTossBetSubmit">
            <constraints/>
            <properties>
              <text value="Button"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
